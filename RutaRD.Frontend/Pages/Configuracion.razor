@page "/Configuracion"
@using Frontend.Services
@inject AuthService AuthService

<PageTitle>Configuración - RutaRD</PageTitle>

<div class="config-page">
    <div class="config-header">
        <h1>Panel de Administración</h1>
        <p>Gestiona usuarios, contenido y configuración de RutaRD</p>
    </div>

    <!-- Tabs principales -->
    <div class="config-tabs">
        <button class="config-tab @(tabActivo == "usuarios" ? "activo" : "")"
            @onclick='() => tabActivo = "usuarios"'>
            Gestión de Usuarios
        </button>
        <button class="config-tab @(tabActivo == "publicacion" ? "activo" : "")"
            @onclick='() => tabActivo = "publicacion"'>
            Publicación de Información
        </button>
        <button class="config-tab @(tabActivo == "general" ? "activo" : "")"
            @onclick='() => tabActivo = "general"'>
            Configuración General
        </button>
    </div>

    <div class="config-container">

        <!-- TAB: Gestión de Usuarios -->
        @if (tabActivo == "usuarios")
        {
            <div class="config-section">
                <div class="section-header">
                    <h2>Usuarios Registrados</h2>
                    <button class="btn-agregar" @onclick="() => mostrarFormUsuario = !mostrarFormUsuario">
                        + Agregar Usuario
                    </button>
                </div>

                @if (mostrarFormUsuario)
                {
                    <div class="form-inline">
                        <div class="form-grupo">
                            <label>Nombre completo</label>
                            <input type="text" @bind="nuevoNombre" placeholder="Ej: Juan Pérez" />
                        </div>
                        <div class="form-grupo">
                            <label>Correo electrónico</label>
                            <input type="email" @bind="nuevoCorreo" placeholder="correo@ejemplo.com" />
                        </div>
                        <div class="form-grupo">
                            <label>Contraseña</label>
                            <input type="password" @bind="nuevoPassword" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <div class="form-grupo">
                            <label>Rol</label>
                            <select @bind="nuevoRol">
                                <option value="Cliente">Cliente</option>
                                <option value="Administrador">Administrador</option>
                            </select>
                        </div>
                        <div class="form-acciones">
                            <button class="btn-guardar" @onclick="AgregarUsuario">Guardar</button>
                            <button class="btn-cancelar" @onclick="() => mostrarFormUsuario = false">Cancelar</button>
                        </div>
                        @if (!string.IsNullOrEmpty(mensajeUsuario))
                        {
                            <p class="msg-exito">@mensajeUsuario</p>
                        }
                    </div>
                }

                <div class="tabla-container">
                    <table class="usuarios-tabla">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < usuarios.Count; i++)
                            {
                                var idx = i;
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@usuarios[i].Nombre</td>
                                    <td>@usuarios[i].Correo</td>
                                    <td>
                                        <span class="rol-badge @(usuarios[i].Rol == "Administrador" ? "admin" : "cliente")">
                                            @usuarios[i].Rol
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-eliminar" @onclick="() => EliminarUsuario(idx)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- TAB: Publicación de Información -->
        @if (tabActivo == "publicacion")
        {
            <div class="config-section">
                <div class="section-header">
                    <h2>Agregar Destino Turístico</h2>
                </div>

                <div class="form-publicacion">
                    <div class="form-fila">
                        <div class="form-grupo">
                            <label>Categoría *</label>
                            <select @bind="pubCategoria">
                                <option value="">Selecciona una categoría</option>
                                <option value="Hotel">Hotel</option>
                                <option value="Restaurante">Restaurante</option>
                                <option value="Turismo Ecológico">Turismo Ecológico</option>
                                <option value="Turismo Cultural">Turismo Cultural</option>
                                <option value="Evento o Actividad">Evento o Actividad</option>
                            </select>
                        </div>
                        <div class="form-grupo">
                            <label>Nombre *</label>
                            <input type="text" @bind="pubNombre" placeholder="Nombre del lugar o servicio" />
                        </div>
                    </div>

                    <div class="form-fila">
                        <div class="form-grupo">
                            <label>Ubicación *</label>
                            <input type="text" @bind="pubUbicacion" placeholder="Ej: Malecón, Puerto Plata" />
                        </div>
                        <div class="form-grupo">
                            <label>Precio</label>
                            <input type="text" @bind="pubPrecio" placeholder="Ej: RD$ 3,500 por noche" />
                        </div>
                    </div>

                    <div class="form-grupo">
                        <label>Descripción *</label>
                        <textarea @bind="pubDescripcion" placeholder="Describe el lugar o servicio..."></textarea>
                    </div>

                    <div class="form-fila">
                        <div class="form-grupo">
                            <label>Horario</label>
                            <input type="text" @bind="pubHorario" placeholder="Ej: Lun - Dom: 8:00am - 6:00pm" />
                        </div>
                        <div class="form-grupo">
                            <label>Teléfono</label>
                            <input type="text" @bind="pubTelefono" placeholder="Ej: 809-555-1234" />
                        </div>
                    </div>

                    <div class="form-grupo">
                        <label>URL de imagen</label>
                        <input type="text" @bind="pubImagen" placeholder="/images/hoteles/nombre.jpg" />
                    </div>

                    <div class="form-grupo">
                        <label>URL de Google Maps</label>
                        <input type="text" @bind="pubMaps" placeholder="https://maps.google.com/..." />
                    </div>

                    <div class="form-acciones">
                        <button class="btn-guardar" @onclick="PublicarInformacion">
                            Publicar
                        </button>
                        <button class="btn-cancelar" @onclick="LimpiarFormPublicacion">
                            Limpiar
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajePublicacion))
                    {
                        <p class="msg-exito">@mensajePublicacion</p>
                    }
                </div>
            </div>
        }

        <!-- TAB: Configuración General -->
        @if (tabActivo == "general")
        {
            <div class="config-section">
                <h2>Idioma</h2>
                <div class="config-option">
                    <label>Idioma de la aplicación</label>
                    <select @bind="idiomaSeleccionado" class="config-select">
                        <option value="es">Español</option>
                        <option value="en">English</option>
                    </select>
                </div>
            </div>

            <div class="config-section">
                <h2>Apariencia</h2>
                <div class="config-option">
                    <label>Tema</label>
                    <div class="tema-opciones">
                        <button class="tema-btn @(temaActivo == "claro" ? "activo" : "")"
                            @onclick='() => temaActivo = "claro"'>Claro</button>
                        <button class="tema-btn @(temaActivo == "oscuro" ? "activo" : "")"
                            @onclick='() => temaActivo = "oscuro"'>Oscuro</button>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2>Notificaciones</h2>
                <div class="config-option toggle-option">
                    <label>Notificaciones de eventos</label>
                    <div class="toggle @(notificacionesEventos ? "activo" : "")"
                        @onclick="() => notificacionesEventos = !notificacionesEventos">
                        <div class="toggle-circle"></div>
                    </div>
                </div>
                <div class="config-option toggle-option">
                    <label>Notificaciones de ofertas</label>
                    <div class="toggle @(notificacionesOfertas ? "activo" : "")"
                        @onclick="() => notificacionesOfertas = !notificacionesOfertas">
                        <div class="toggle-circle"></div>
                    </div>
                </div>
            </div>

            <div class="config-section">
                <h2>Acerca de RutaRD</h2>
                <div class="acerca-info">
                    <p><strong>Versión:</strong> 1.0.0</p>
                    <p><strong>Desarrollado por:</strong> Facultad de Ingeniería y Tecnología, UNAD</p>
                    <p><strong>Contacto:</strong> info@rutard.com</p>
                    <div class="acerca-links">
                        <a href="#">Términos de uso</a>
                        <a href="#">Política de privacidad</a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private string tabActivo = "usuarios";

    // Gestión de usuarios
    private bool mostrarFormUsuario = false;
    private string nuevoNombre = "";
    private string nuevoCorreo = "";
    private string nuevoPassword = "";
    private string nuevoRol = "Cliente";
    private string mensajeUsuario = "";

    private List<Usuario> usuarios = new()
    {
        new Usuario { Nombre = "Administrador", Correo = "admin@rutard.com", Rol = "Administrador" },
        new Usuario { Nombre = "Lyn Paulino", Correo = "lyn@gmail.com", Rol = "Cliente" },
        new Usuario { Nombre = "Ian Heredia", Correo = "ian@gmail.com", Rol = "Cliente" },
    };

    private void AgregarUsuario()
    {
        if (string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoCorreo)) return;
        usuarios.Add(new Usuario { Nombre = nuevoNombre, Correo = nuevoCorreo, Rol = nuevoRol });
        mensajeUsuario = "Usuario agregado exitosamente.";
        nuevoNombre = nuevoCorreo = nuevoPassword = "";
        mostrarFormUsuario = false;
    }

    private void EliminarUsuario(int idx)
    {
        if (idx >= 0 && idx < usuarios.Count)
            usuarios.RemoveAt(idx);
    }

    // Publicación
    private string pubCategoria = "";
    private string pubNombre = "";
    private string pubUbicacion = "";
    private string pubPrecio = "";
    private string pubDescripcion = "";
    private string pubHorario = "";
    private string pubTelefono = "";
    private string pubImagen = "";
    private string pubMaps = "";
    private string mensajePublicacion = "";

    private void PublicarInformacion()
    {
        if (string.IsNullOrWhiteSpace(pubCategoria) || string.IsNullOrWhiteSpace(pubNombre)) return;
        mensajePublicacion = $"'{pubNombre}' publicado exitosamente en {pubCategoria}.";
        LimpiarFormPublicacion();
    }

    private void LimpiarFormPublicacion()
    {
        pubCategoria = pubNombre = pubUbicacion = pubPrecio = "";
        pubDescripcion = pubHorario = pubTelefono = pubImagen = pubMaps = "";
    }

    // Configuración general
    private string idiomaSeleccionado = "es";
    private string temaActivo = "claro";
    private bool notificacionesEventos = true;
    private bool notificacionesOfertas = false;
}