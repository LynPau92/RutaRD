@page "/Eventos-actividades/{Id:int}"
@using Frontend.Models
@inject Frontend.Services.EventosActividadesService EventosActividadesService

<PageTitle>@(evento?.Nombre ?? "Evento") - RutaRD</PageTitle>

@if (evento == null)
{
    <div class="not-found">
        <h2>Evento no encontrado</h2>
        <a href="Eventos-actividades" class="btn-volver">← Volver</a>
    </div>
}
else
{
    <div class="detalle-page">
        <div class="detalle-hero" style="background-image: url('@evento.Imagen')">
            <div class="detalle-hero-overlay"></div>
            <div class="detalle-hero-content">
                <a href="Eventos-actividades" class="btn-volver">← Volver</a>
                <h1>@evento.Nombre</h1>
                <p>@evento.Ubicacion</p>
                <span class="tipo-badge @evento.Tipo.ToLower()">@evento.Tipo</span>
            </div>
        </div>

        <div class="detalle-container">
            <div class="detalle-seccion">
                <h2>Descripción</h2>
                <p>@evento.Descripcion</p>
            </div>

            <div class="detalle-seccion">
                <h2>Información</h2>
                <p>Fecha: <strong>@evento.Fecha</strong></p>
                <p>Horario: <strong>@evento.Horario</strong></p>
                <p>Entrada: <strong>@evento.PrecioEntrada</strong></p>
                <div class="detalle-actions">
                    <a href="@evento.GoogleMapsUrl" target="_blank" class="btn-mapa">Ver en Mapa</a>
                    <a href="@evento.SitioWeb" target="_blank" class="btn-sitio">Sitio Web</a>
                </div>
            </div>

            <div class="detalle-seccion">
                <h2>Reseñas de Visitantes</h2>
                @if (evento.Resenas.Any())
                {
                    @foreach (var resena in evento.Resenas)
                    {
                        <div class="resena-card">
                            <div class="resena-header">
                                <div class="resena-avatar">@resena.NombreVisitante[0]</div>
                                <div>
                                    <p class="resena-nombre">@resena.NombreVisitante</p>
                                    <p class="resena-fecha">@resena.Fecha</p>
                                </div>
                                <div class="resena-estrellas">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= resena.Calificacion ? "estrella activa" : "estrella")">★</span>
                                    }
                                </div>
                            </div>
                            <p class="resena-comentario">@resena.Comentario</p>
                        </div>
                    }
                }
                else
                {
                    <p class="sin-resenas">Aún no hay reseñas para este evento.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private EventosActividades? evento;

    protected override void OnInitialized()
    {
        evento = EventosActividadesService.GetEvento(Id);
    }
}