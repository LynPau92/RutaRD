@using Frontend.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="navbar-wrapper">
    <!-- Barra superior -->
    <div class="navbar-top-bar">
        <div class="navbar-top-container">
            <span>Puerto Plata, República Dominicana</span>
            <span>info@rutard.com</span>
        </div>
    </div>

    <!-- Barra principal -->
    <div class="navbar-main">
        <div class="navbar-container">
            <a class="navbar-logo" href="">
                <img src="images/RutaRD.png" alt="RutaRD logo" width="42" height="42" />
                <span>RutaRD</span>
            </a>

            <!-- Botón hamburguesa -->
            <button class="hamburger @(menuAbierto ? "activo" : "")" @onclick="ToggleMenu">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <nav class="navbar-links @(menuAbierto ? "abierto" : "")">
                <NavLink href="" Match="NavLinkMatch.All" @onclick="CerrarMenu">Inicio</NavLink>
                <NavLink href="Restaurantes" @onclick="CerrarMenu">Restaurantes</NavLink>
                <NavLink href="Hoteles" @onclick="CerrarMenu">Hoteles</NavLink>
                <NavLink href="Eventos-actividades" @onclick="CerrarMenu">Eventos y Actividades</NavLink>
                <NavLink href="Turismo-cultural" @onclick="CerrarMenu">Turismo Cultural</NavLink>
                <NavLink href="Turismo-ecologico" @onclick="CerrarMenu">Turismo Ecológico</NavLink>

                <!-- Mis Reservas con badge -->
                <NavLink href="MisReservas" @onclick="CerrarMenu" class="nav-mis-reservas">
                    <span>Mis Reservas</span>
                    @if (tieneReservaActiva)
                    {
                        <span class="reserva-activa-badge">🏠</span>
                    }
                </NavLink>

                @if (AuthService.EsAdmin)
                {
                    <NavLink href="Configuracion" @onclick="CerrarMenu">Configuración</NavLink>
                }

                <!-- Usuario y cerrar sesión -->
                <div class="navbar-usuario">
                    <span class="usuario-nombre"> @AuthService.UsuarioActual?.Nombre</span>
                    <button class="btn-cerrar-sesion" @onclick="CerrarSesion">Cerrar sesión</button>
                </div>
            </nav>
        </div>
    </div>
</div>

@code {
    private bool menuAbierto = false;
    private bool tieneReservaActiva = false;

    private void ToggleMenu() => menuAbierto = !menuAbierto;
    private void CerrarMenu() => menuAbierto = false;

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnCambio += StateHasChanged;
        await VerificarReservaActiva();
    }

    private async Task VerificarReservaActiva()
    {
        try
        {
            var tieneReserva = await JS.InvokeAsync<string>("localStorage.getItem", "tieneReservaActiva");
            tieneReservaActiva = tieneReserva == "true";
        }
        catch
        {
            tieneReservaActiva = false;
        }
    }

    public void Dispose()
    {
        AuthService.OnCambio -= StateHasChanged;
    }

    private async Task CerrarSesion()
    {
        await AuthService.CerrarSesion();

        // Limpiar localStorage de reservas al cerrar sesión
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "tieneReservaActiva");
            await JS.InvokeVoidAsync("localStorage.removeItem", "ultimaReservaId");
        }
        catch { }

        Navigation.NavigateTo("/Login");
    }
}
