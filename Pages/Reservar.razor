@page "/Reservar"
@using Frontend.Models
@inject Frontend.Services.HotelService HotelService
@inject NavigationManager Navigation

<PageTitle>Reservar - RutaRD</PageTitle>

<div class="reservar-page">
    <div class="reservar-header">
        <h1>Completa tu Reserva</h1>
        <p>Estás a un paso de tu próxima aventura en Puerto Plata</p>
    </div>

    <div class="reservar-container">
        <!-- Resumen de la reserva -->
        <div class="reservar-resumen">
            <h2>Resumen</h2>
            <div class="resumen-hotel">
                <img src="@hotel?.Imagen" alt="@hotel?.Nombre" class="resumen-img" />
                <div>
                    <h3>@hotel?.Nombre</h3>
                    <p>📍 @hotel?.Ubicacion</p>
                    <div class="resumen-estrellas">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= (hotel?.Estrellas ?? 0) ? "estrella activa" : "estrella")">★</span>
                        }
                    </div>
                </div>
            </div>

            <div class="resumen-detalles">
                <div class="resumen-fila">
                    <span>Check-in</span>
                    <span>@reserva.FechaEntrada.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="resumen-fila">
                    <span>Check-out</span>
                    <span>@reserva.FechaSalida.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="resumen-fila">
                    <span>Noches</span>
                    <span>@reserva.Noches</span>
                </div>
                <div class="resumen-fila">
                    <span>Habitaciones</span>
                    <span>@reserva.Habitaciones</span>
                </div>
                <div class="resumen-fila">
                    <span>Adultos</span>
                    <span>@reserva.Adultos</span>
                </div>
                <div class="resumen-fila">
                    <span>Niños</span>
                    <span>@reserva.Ninos</span>
                </div>
                <div class="resumen-fila total">
                    <span>Total Estimado</span>
                    <span>RD$ @reserva.TotalEstimado.ToString("N2")</span>
                </div>
            </div>
        </div>

        <!-- Formulario -->
        <div class="reservar-formulario">
            <h2>Tus Datos</h2>

            @if (reservaExitosa)
            {
                <div class="exito-msg">
                    <p>✅ ¡Reserva enviada exitosamente!</p>
                    <p>Te contactaremos pronto para confirmar tu reserva.</p>
                    <a href="Hoteles" class="btn-volver-hoteles">Ver más hoteles</a>
                </div>
            }
            else
            {
                <div class="form-grupo">
                    <label>Nombre completo *</label>
                    <input type="text" @bind="nombre" placeholder="Ej: María González" class="@(mostrarErrores && string.IsNullOrWhiteSpace(nombre) ? "input-error" : "")" />
                    @if (mostrarErrores && string.IsNullOrWhiteSpace(nombre))
                    {
                        <span class="error-msg">El nombre es requerido</span>
                    }
                </div>

                <div class="form-grupo">
                    <label>Correo electrónico *</label>
                    <input type="email" @bind="correo" placeholder="Ej: maria@gmail.com" class="@(mostrarErrores && !CorreoValido ? "input-error" : "")" />
                    @if (mostrarErrores && !CorreoValido)
                    {
                        <span class="error-msg">Ingresa un correo válido</span>
                    }
                </div>

                <div class="form-grupo">
                    <label>Teléfono *</label>
                    <input type="tel" @bind="telefono" placeholder="Ej: 809-555-1234" class="@(mostrarErrores && string.IsNullOrWhiteSpace(telefono) ? "input-error" : "")" />
                    @if (mostrarErrores && string.IsNullOrWhiteSpace(telefono))
                    {
                        <span class="error-msg">El teléfono es requerido</span>
                    }
                </div>

                <div class="form-grupo">
                    <label>Solicitudes especiales</label>
                    <textarea @bind="solicitudes" placeholder="Ej: Cama doble, piso alto, llegada tardía..."></textarea>
                </div>

                <button class="btn-reservar" @onclick="EnviarReserva">
                    Confirmar Reserva
                </button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int HotelId { get; set; }
    [SupplyParameterFromQuery] public string FechaEntrada { get; set; } = "";
    [SupplyParameterFromQuery] public string FechaSalida { get; set; } = "";
    [SupplyParameterFromQuery] public int Adultos { get; set; } = 1;
    [SupplyParameterFromQuery] public int Ninos { get; set; } = 0;
    [SupplyParameterFromQuery] public int Habitaciones { get; set; } = 1;

    private Hotel? hotel;
    private Reserva reserva = new();
    private string nombre = "";
    private string correo = "";
    private string telefono = "";
    private string solicitudes = "";
    private bool mostrarErrores = false;
    private bool reservaExitosa = false;

    private bool CorreoValido => !string.IsNullOrWhiteSpace(correo) && correo.Contains("@") && correo.Contains(".");

    protected override void OnInitialized()
    {
        hotel = HotelService.GetHotel(HotelId);
        if (hotel != null)
        {
            reserva = new Reserva
            {
                HotelId = HotelId,
                NombreHotel = hotel.Nombre,
                FechaEntrada = DateTime.TryParse(FechaEntrada, out var entrada) ? entrada : DateTime.Today.AddDays(1),
                FechaSalida = DateTime.TryParse(FechaSalida, out var salida) ? salida : DateTime.Today.AddDays(2),
                Adultos = Adultos,
                Ninos = Ninos,
                Habitaciones = Habitaciones,
                PrecioNoche = hotel.PrecioNoche
            };
        }
    }

    private void EnviarReserva()
    {
        mostrarErrores = true;
        if (string.IsNullOrWhiteSpace(nombre) || !CorreoValido || string.IsNullOrWhiteSpace(telefono))
            return;
        reservaExitosa = true;
    }
}