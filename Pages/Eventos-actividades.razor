@page "/Eventos-actividades"
@using Frontend.Models
@inject Frontend.Services.EventosActividadesService EventosActividadesService

<PageTitle>Eventos y Actividades - Puerto Plata</PageTitle>

<div class="eventos-page">
    <div class="eventos-header">
        <h1>Eventos y Actividades en Puerto Plata</h1>
        <p>Vive experiencias únicas en la Novia del Atlántico</p>
    </div>

    <!-- Filtros -->
    <div class="filtros">
        <button class="filtro-btn @(filtroActivo == "" ? "activo" : "")" @onclick='() => filtroActivo = ""'>Todos</button>
        <button class="filtro-btn @(filtroActivo == "Actividad" ? "activo" : "")" @onclick='() => filtroActivo = "Actividad"'>Actividades</button>
        <button class="filtro-btn @(filtroActivo == "Festival" ? "activo" : "")" @onclick='() => filtroActivo = "Festival"'>Festivales</button>
    </div>

    <div class="eventos-grid">
        @foreach (var evento in EventosFiltrados)
        {
            <div class="evento-card">
                <div class="evento-img-container">
                    <img src="@evento.Imagen" alt="@evento.Nombre" class="evento-img" />
                    <span class="tipo-badge @evento.Tipo.ToLower()">@evento.Tipo</span>
                </div>
                <div class="evento-info">
                    <h3 class="evento-nombre">@evento.Nombre</h3>
                    <p class="evento-ubicacion">@evento.Ubicacion</p>
                    <p class="evento-descripcion">@evento.Descripcion</p>
                    <div class="evento-detalles">
                        <span>@evento.Fecha</span>
                        <span>@evento.Horario</span>
                        <span>@evento.PrecioEntrada</span>
                    </div>
                    <div class="evento-actions">
                        <a href="Eventos-actividades/@evento.Id" class="btn-detalle">Ver más</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<EventosActividades> eventos = new();
    private string filtroActivo = "";

    private IEnumerable<EventosActividades> EventosFiltrados =>
        string.IsNullOrEmpty(filtroActivo)
            ? eventos
            : eventos.Where(e => e.Tipo == filtroActivo);

    protected override void OnInitialized()
    {
        eventos = EventosActividadesService.GetEventos();
    }
}