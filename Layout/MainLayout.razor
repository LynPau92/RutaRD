@using Frontend.Shared
@inherits LayoutComponentBase
<div class="page">
    <NavMenu />

    <main>
        <article class="content">
            @Body
        </article>

        <footer class="footer">
            <div class="footer-container">
                <!-- Logo y descripción -->
                <div class="footer-brand">
                    <img src="images/RutaRD.png" alt="RutaRD logo" width="48" height="48" />
                    <span class="footer-logo-text">RutaRD</span>
                    <p class="footer-desc">Tu guía de turismo local en Puerto Plata, República Dominicana.</p>
                    <div class="footer-social">
                        <a href="#" title="Facebook">
                            <img src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/facebook.svg" width="22"
                                 height="22" />
                        </a>
                        <a href="#" title="Instagram">
                            <img src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/instagram.svg"
                                 width="22" height="22" />
                        </a>
                        <a href="#" title="YouTube">
                            <img src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/youtube.svg" width="22"
                                 height="22" />
                        </a>
                        <a href="#" title="TikTok">
                            <img src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/tiktok.svg" width="22"
                                 height="22" />
                        </a>
                    </div>
                </div>

                <!-- Links para cada módulo-->
                <div class="footer-links">
                    <h4>Explorar</h4>
                    <a href="Restaurantes">Restaurantes</a>
                    <a href="Hoteles">Hoteles</a>
                    <a href="Eventos-actividades">Eventos y Actividades</a>
                    <a href="Turismo-cultural">Turismo Cultural</a>
                    <a href="Turismo-ecologico">Turismo Ecológico</a>
                </div>

                <!-- Contacto -->
                <div class="footer-contact">
                    <h4>Contacto</h4>
                    <p>📍 Puerto Plata, República Dominicana</p>
                    <p>📞 +1 (809) 789-4512</p>
                    <p>✉️ info@rutard.com</p>
                    <p>🕐 Lun - Vie: 8:00am - 5:00pm</p>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 RutaRD. Todos los derechos reservados.</p>
            </div>
        </footer>
    </main>
    <ChatBot />
</div>